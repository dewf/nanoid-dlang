/++
    Non-cryptographic Nano ID generator backed by `std.random.rndGen`.

    $(B Security Warning:) IDs generated by this module are $(B not)
    cryptographically secure and have predictable output. Use the main
    `nanoid` module unless you explicitly do not need cryptographic
    unpredictability.

    Examples:
    ---
    import nanoid.nonsecure : nanoid, customAlphabet;

    string id = nanoid();
    auto hexGen = customAlphabet("0123456789abcdef", 10);
    string shortHex = hexGen();
    ---
 +/
module nanoid.nonsecure;

import std.array : appender;
import std.exception : assumeUnique;
import std.random : uniform;
import std.utf : decode, encode, UTFException;

public import nanoid : defaultSize, NanoIdException, urlAlphabet;
import nanoid : isPureAscii;

/++
    Fills `buffer` in place with a non-secure URL-safe Nano ID using
    `std.random.rndGen`.
 +/
char[] nanoidInto(return scope char[] buffer) @safe
{
    foreach (ref char c; buffer)
        c = urlAlphabet[uniform!"[)"(size_t(0), urlAlphabet.length)];
    return buffer;
}

/++
    Generates a non-secure URL-friendly Nano ID using `std.random.rndGen`.

    Params:
        size = Number of characters in the generated ID (default: 21).

    Returns:
        A newly allocated `string` of length `size`.
 +/
string nanoid(size_t size = defaultSize) @safe
{
    if (size == 0)
        return "";

    auto buffer = new char[size];
    nanoidInto(buffer);
    return () @trusted { return assumeUnique(buffer); }();
}

/++
    Generates a stack-allocated, fixed-length non-secure URL-friendly Nano ID.
 +/
char[size] nanoid(size_t size)() @safe
{
    char[size] buffer;
    static if (size > 0)
        nanoidInto(buffer[]);
    return buffer;
}

/// Convenience alias for `nanoid.nonsecure.nanoid`.
alias generate = nanoid;

/++
    A non-secure Nano ID generator bound to a custom alphabet and default size.
 +/
struct NonSecureGenerator
{
    private string _ascii;
    private dstring _unicode;
    private size_t _alphabetLength;
    private size_t _defaultSize;
    private bool _isAscii;

    /// Returns the default ID length (in symbols).
    size_t defaultSize() const pure nothrow @safe @nogc
    {
        return _defaultSize;
    }

    /// Returns the number of symbols (Unicode code points) in the alphabet.
    size_t alphabetLength() const pure nothrow @safe @nogc
    {
        return _alphabetLength;
    }

    /// Returns `true` if every symbol in the alphabet is single-byte ASCII.
    bool isAscii() const pure nothrow @safe @nogc
    {
        return _isAscii;
    }

    /// Generates an ID of length `defaultSize`.
    string opCall() const @safe
    {
        return opCall(_defaultSize);
    }

    /// Generates an ID containing `size` symbols from this generator's alphabet.
    string opCall(size_t size) const @safe
    {
        if (size == 0)
            return "";

        if (_isAscii)
        {
            auto buffer = new char[size];
            into(buffer);
            return () @trusted { return assumeUnique(buffer); }();
        }

        if (_alphabetLength == 1)
        {
            char[4] encoded;
            immutable size_t unitLen = encode(encoded, _unicode[0]);
            auto buffer = new char[unitLen * size];
            for (size_t i = 0; i < buffer.length; i += unitLen)
                buffer[i .. i + unitLen] = encoded[0 .. unitLen];
            return () @trusted { return assumeUnique(buffer); }();
        }

        auto app = appender!string();
        app.reserve(size * 2);
        foreach (_; 0 .. size)
            app.put(_unicode[uniform!"[)"(size_t(0), _alphabetLength)]);
        return app.data;
    }

    /// Fills `buffer` in place with ASCII symbols from this generator's alphabet.
    char[] into(return scope char[] buffer) const @safe
    {
        if (!_isAscii)
            throw new NanoIdException(
                "into(char[]) requires an ASCII alphabet; use into(dchar[]) or opCall() for Unicode alphabets."
            );

        if (buffer.length == 0)
            return buffer;

        if (_alphabetLength == 1)
        {
            buffer[] = _ascii[0];
            return buffer;
        }

        foreach (ref char c; buffer)
            c = _ascii[uniform!"[)"(size_t(0), _alphabetLength)];
        return buffer;
    }

    /// Fills `buffer` in place with Unicode code points from this generator's alphabet.
    dchar[] into(return scope dchar[] buffer) const @safe
    {
        if (buffer.length == 0)
            return buffer;

        if (_alphabetLength == 1)
        {
            buffer[] = _isAscii ? cast(dchar) _ascii[0] : _unicode[0];
            return buffer;
        }

        if (_isAscii)
        {
            foreach (ref dchar c; buffer)
                c = cast(dchar) _ascii[uniform!"[)"(size_t(0), _alphabetLength)];
        }
        else
        {
            foreach (ref dchar c; buffer)
                c = _unicode[uniform!"[)"(size_t(0), _alphabetLength)];
        }
        return buffer;
    }
}

/++
    Creates a non-secure Nano ID generator using a custom alphabet and default size.

    Can be evaluated at compile time (CTFE).

    Params:
        alphabet = Allowed symbols for generated IDs (must be non-empty).
        size     = Default length of generated IDs in symbols (default: 21).

    Returns:
        A callable `NonSecureGenerator`.

    Throws:
        `NanoIdException` if `alphabet` is empty or contains invalid UTF-8.
 +/
NonSecureGenerator customAlphabet(string alphabet, size_t size = defaultSize) pure @safe
{
    if (alphabet.length == 0)
        throw new NanoIdException("Alphabet must not be empty.");

    if (isPureAscii(alphabet))
        return NonSecureGenerator(alphabet, null, alphabet.length, size, true);

    dchar[] symbols;
    size_t idx = 0;
    try
    {
        while (idx < alphabet.length)
            symbols ~= decode(alphabet, idx);
    }
    catch (UTFException e)
    {
        throw new NanoIdException("Alphabet contains invalid UTF-8: " ~ e.msg);
    }

    dstring uni = symbols.idup;
    return NonSecureGenerator(null, uni, uni.length, size, false);
}

// ---------------------------------------------------------------------------
// Unit tests
// ---------------------------------------------------------------------------

unittest
{
    import std.algorithm.searching : canFind;
    import std.exception : assertThrown;
    import std.range.primitives : walkLength;
    import std.utf : byDchar;

    // Verify external import ergonomics of the parent `nanoid` package too.
    {
        import nanoid;
        assert(nanoid.nanoid().length == 21);
        assert(nanoid.generate().length == 21);
        assert(nanoid.customAlphabet("ab", 4)().length == 4);
    }

    assert(nanoid(0) == "");
    assert(generate(0) == "");

    foreach (_; 0 .. 100)
    {
        string id = nanoid();
        assert(id.length == 21);
        foreach (char c; id)
            assert(urlAlphabet.canFind(c));
    }

    assert(nanoid(10).length == 10);
    assert(nanoid!12().length == 12);

    char[16] buf;
    nanoidInto(buf[]);
    foreach (char c; buf)
        assert(urlAlphabet.canFind(c));

    // Collision check across 50,000 IDs.
    bool[string] seen;
    foreach (_; 0 .. 50_000)
    {
        string id = nanoid();
        assert(id !in seen);
        seen[id] = true;
    }

    // customAlphabet ASCII, single-symbol, CTFE, and Unicode.
    static immutable hexGen = customAlphabet("0123456789abcdef", 10);
    assert(hexGen.defaultSize == 10);
    assert(hexGen.alphabetLength == 16);
    assert(hexGen.isAscii);
    assert(hexGen().length == 10);
    assert(hexGen(0) == "");

    assert(customAlphabet("a", 5)() == "aaaaa");
    assert(customAlphabet("🚀", 3)() == "🚀🚀🚀");

    auto uniGen = customAlphabet("абвгд", 10);
    assert(!uniGen.isAscii);
    string u = uniGen();
    assert(u.byDchar.walkLength == 10);
    foreach (dchar c; u.byDchar)
        assert("абвгд".byDchar.canFind(c));

    char[5] cbuf;
    assertThrown!NanoIdException(uniGen.into(cbuf[]));
    dchar[5] dbuf;
    uniGen.into(dbuf[]);
    foreach (dchar c; dbuf)
        assert("абвгд".byDchar.canFind(c));

    assertThrown!NanoIdException(customAlphabet(""));
    immutable char[2] badUtf8 = [cast(char) 0xFF, cast(char) 0xFE];
    assertThrown!NanoIdException(customAlphabet(badUtf8.idup));
}

unittest
{
    // Flat distribution test for non-secure nanoid() and customAlphabet().
    enum size_t count = 50_000;
    enum size_t len = 30;
    enum string alphabet = "abcdefghijklmnopqrstuvwxyz";
    auto gen = customAlphabet(alphabet, len);

    size_t[256] counts;
    char[len] buf;
    foreach (_; 0 .. count)
    {
        gen.into(buf[]);
        foreach (char c; buf)
            ++counts[cast(ubyte) c];
    }

    double minDist = double.max;
    double maxDist = 0.0;
    size_t distinct = 0;
    foreach (char c; alphabet)
    {
        immutable size_t n = counts[cast(ubyte) c];
        if (n > 0)
            ++distinct;
        immutable double dist = (cast(double) n * alphabet.length) / (count * len);
        if (dist < minDist) minDist = dist;
        if (dist > maxDist) maxDist = dist;
    }
    assert(distinct == alphabet.length);
    assert(maxDist - minDist <= 0.05);
}
